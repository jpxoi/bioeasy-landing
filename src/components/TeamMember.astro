---
import { getCdnImageUrl } from '../lib/cdn-image'

interface Props {
  id: number
  name: string
  title: string
  avatarKey: string
}

const { name, title, avatarKey } = Astro.props

const cdnURL = import.meta.env.PUBLIC_CDN_URL
const avifSrc = getCdnImageUrl(cdnURL, avatarKey, 'avif')
const webpSrc = getCdnImageUrl(cdnURL, avatarKey, 'webp')
const fallbackSrc = webpSrc
---

<div
  class='group flex w-full flex-col items-center gap-3 rounded-lg border border-gray-200 bg-white px-4 pt-4 pb-4 shadow-sm transition-all duration-300 hover:border-teal-700/20'
>
  <picture
    class='transition-transform duration-300 group-hover:scale-105 group-hover:drop-shadow-lg group-hover:drop-shadow-teal-700/40'
  >
    <source srcset={avifSrc} type='image/avif' />
    <source srcset={webpSrc} type='image/webp' />
    <img
      class='aspect-3/4 h-auto max-w-44 mask-[linear-gradient(to_bottom,black_75%,transparent_100%)] object-cover'
      src={fallbackSrc}
      loading='lazy'
      alt={`Foto de ${name}, docente en Bioeasy Galenos`}
      width='402'
      height='536'
    />
  </picture>
  <div class='flex flex-col items-center gap-1'>
    <h5 class='line-clamp-1 text-center leading-tight font-semibold tracking-tight text-gray-900 sm:text-lg'>{name}</h5>
    <span class='line-clamp-1 text-center text-sm leading-tight font-normal text-gray-500'>{title}</span>
  </div>
</div>
