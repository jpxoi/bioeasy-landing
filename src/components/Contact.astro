---
import SectionHeading from './SectionHeading.astro'
import ContactCard from './ContactCard.astro'
import ContactForm from './ContactForm.tsx'
import { WHATSAPP_URL } from '@/lib/whatsapp'

const contact_cards = [
  {
    id: 'email_contact',
    icon: 'envelope',
    contact_title: 'Correo electrónico',
    contact_info: 'informes@bgmedicina.com',
    contact_link: 'mailto:informes@bgmedicina.com',
    contact_cta: 'Escríbenos',
  },
  {
    id: 'whatsapp',
    icon: 'phone',
    contact_title: 'WhatsApp',
    contact_info: '+51 940 256 869',
    contact_link: WHATSAPP_URL,
    contact_cta: 'Escríbenos',
  },
]
---

<section id='contacto' class='mx-auto flex w-full max-w-7xl flex-col gap-8 p-8 pt-24'>
  <SectionHeading title='Contáctanos' />
  <div class='grid gap-10 md:grid-cols-[3fr_4fr] md:items-start'>
    <div class='grid grid-cols-1 justify-items-center gap-2 max-md:w-full sm:grid-cols-2 md:grid-cols-1 md:gap-4'>
      {contact_cards.map((contact_card) => <ContactCard {...contact_card} />)}
    </div>
    <ContactForm client:visible />
  </div>
</section>
