---
import Skeleton from './Skeleton.astro'
---

<div class='courses__content mx-auto flex w-full max-w-6xl flex-col items-center gap-6'>
  <div
    class='courses__content__grid grid w-full grid-cols-1 justify-items-center gap-4 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4'
  >
    {
      Array(8)
        .fill(0)
        .map(() => (
          <div class='flex w-full max-w-sm flex-col rounded-lg border border-gray-200 bg-white shadow-sm'>
            <Skeleton className='w-full h-full aspect-square rounded-t-lg sm:aspect-8/10 leading-none rounded-b-none' />
            <div class='flex flex-1 flex-col gap-4 p-5 text-center'>
              <div class='flex flex-col items-center gap-2'>
                <div class='flex items-center justify-center gap-2'>
                  <Skeleton className='w-12 rounded-md h-6' />
                  <Skeleton className='w-12 rounded-md h-6' />
                </div>
                <Skeleton className='w-40 h-8' />
              </div>
              <div class='flex h-20 flex-1 flex-col gap-1 py-0.5'>
                <Skeleton className='w-full h-4' />
                <Skeleton className='w-full h-4' />
                <Skeleton className='w-full h-4' />
                <Skeleton className='w-full h-4 max-sm:hidden' />
              </div>
              <div class='flex items-end justify-center'>
                <Skeleton className='w-30 h-9' />
              </div>
            </div>
          </div>
        ))
    }
  </div>
  <Skeleton className='h-10 min-h-10 w-full max-w-sm min-w-38.25 sm:max-w-38.25' />
</div>
