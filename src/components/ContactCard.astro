---
import { ArrowRight, Mail, Phone } from '@lucide/astro'

interface Props {
  id: string
  icon: string
  contact_title: string
  contact_info: string
  contact_link: string
  contact_cta: string
}

const { id, icon, contact_title, contact_info, contact_link, contact_cta } = Astro.props

const icons = {
  envelope: Mail,
  phone: Phone,
}

const Icon = icons[icon as keyof typeof icons]
const isExternal = contact_link.startsWith('http')
---

<a
  id={id}
  href={contact_link}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noreferrer noopener' : undefined}
  class='flex w-full items-start gap-4 rounded-xl border border-gray-100 bg-gray-50/60 p-5 text-left transition-colors hover:bg-teal-700/10'
>
  <span class='flex size-10 shrink-0 items-center justify-center rounded-lg bg-teal-700/10' aria-hidden='true'>
    <Icon class='size-5 text-teal-700' />
  </span>
  <span class='flex min-w-0 flex-1 flex-col gap-0.5'>
    <span class='text-sm font-medium text-gray-500'>{contact_title}</span>
    <span class='text-base font-semibold tracking-tight text-gray-900'>{contact_info}</span>
    <span class='mt-2 inline-flex items-center gap-1 text-sm font-medium text-teal-600'>
      {contact_cta}
      <ArrowRight class='size-3.5' aria-hidden='true' />
    </span>
  </span>
</a>
