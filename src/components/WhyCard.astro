---
import Award from '@lucide/astro/icons/award'
import Heart from '@lucide/astro/icons/heart'
import Lightbulb from '@lucide/astro/icons/lightbulb'
import BookOpen from '@lucide/astro/icons/book-open'

type WhyIcon = 'award' | 'heart' | 'lightbulb' | 'book-open'

interface Props {
  why_description: string
  icon: WhyIcon
}

const { why_description, icon } = Astro.props

const icons = {
  award: Award,
  heart: Heart,
  lightbulb: Lightbulb,
  'book-open': BookOpen,
}

const Icon = icons[icon]
---

<div
  class='grid items-center rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md max-sm:max-w-sm'
>
  <Icon class='mx-auto mb-3 size-5 text-teal-700' aria-hidden='true' />
  <p class='text-center font-normal text-gray-700'>{why_description}</p>
</div>
