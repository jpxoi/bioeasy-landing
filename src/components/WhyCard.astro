---
import Award from '@lucide/astro/icons/award'
import Heart from '@lucide/astro/icons/heart'
import Lightbulb from '@lucide/astro/icons/lightbulb'
import BookOpen from '@lucide/astro/icons/book-open'

type WhyIcon = 'award' | 'heart' | 'lightbulb' | 'book-open'

interface Props {
  why_description: string
  icon: WhyIcon
}

const { why_description, icon } = Astro.props

const icons = {
  award: Award,
  heart: Heart,
  lightbulb: Lightbulb,
  'book-open': BookOpen,
}

const Icon = icons[icon]
---

<div
  class='flex flex-col items-center justify-start gap-3 rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-all duration-300 hover:border-teal-700/20 hover:shadow-md hover:shadow-teal-700/20 max-sm:max-w-sm'
>
  <Icon class='mx-auto size-5 text-teal-700' aria-hidden='true' />
  <p class='text-center text-gray-700'>{why_description}</p>
</div>
