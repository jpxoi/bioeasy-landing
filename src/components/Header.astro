---
import HeaderMobileMenuButton from '@/components/HeaderMobileMenuButton.tsx'
import HeaderNavLinks from '@/components/HeaderNavLinks.tsx'
import { brandImg, headerCta, headerHeroScrim, headerShell } from '@/lib/header-classes'

interface Props {
  isLanding?: boolean
}

const { isLanding = false } = Astro.props
---

<header
  id='site-header'
  class:list={[headerShell, isLanding ? 'header--landing' : 'is-scrolled']}
  data-at-hero={isLanding ? '' : undefined}
>
  {isLanding && <div class={headerHeroScrim} aria-hidden='true' />}
  <nav
    class='relative z-1 mx-auto grid h-16 max-w-7xl grid-cols-[auto_1fr_auto] items-center gap-3 px-4 sm:gap-4 sm:px-6 lg:px-8'
  >
    <a href={isLanding ? '/#' : '/'} class='relative z-1 shrink-0' data-astro-prefetch>
      <span class='sr-only'>Bioeasy Galenos</span>
      <picture>
        <source srcset='/brand/logo-teal.avif' type='image/avif' />
        <source srcset='/brand/logo-teal.webp' type='image/webp' />
        <img
          class:list={[brandImg, 'h-8 w-auto sm:h-9']}
          src='/brand/logo-teal.webp'
          width='476'
          height='96'
          alt='Bioeasy Galenos'
          loading='eager'
          fetchpriority='high'
        />
      </picture>
    </a>

    <HeaderNavLinks client:load />

    <div class='relative z-1 flex shrink-0 items-center justify-end gap-2'>
      <a href='/campusvirtual' target='_blank' rel='noreferrer noopener' class={headerCta}> Campus Virtual </a>
      <HeaderMobileMenuButton client:load />
    </div>
  </nav>
</header>

{isLanding && <script>import '@/lib/landing-header-scroll'</script>}
