---
import Menu from '@lucide/astro/icons/menu'
import X from '@lucide/astro/icons/x'
import { brandImg, headerCta, headerHeroScrim, headerShell, menuToggle, mobileNavLink, navLink } from '@/lib/header-classes'

interface Props {
  isLanding?: boolean
}

const { isLanding = false } = Astro.props

const navItems = [
  { href: '/#inicio', label: 'Inicio', sectionId: 'inicio' },
  { href: '/#nosotros', label: 'Nosotros', sectionId: 'nosotros' },
  { href: '/#cursos', label: 'Cursos', sectionId: 'cursos' },
  { href: '/#docentes', label: 'Docentes', sectionId: 'docentes' },
  { href: '/#contacto', label: 'Contáctanos', sectionId: 'contacto' },
] as const
---

<header
  id='site-header'
  class:list={[headerShell, isLanding ? 'header--landing' : 'is-scrolled']}
  data-at-hero={isLanding ? '' : undefined}
>
  {isLanding && <div class={headerHeroScrim} aria-hidden='true' />}
  <nav
    class='relative z-1 mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 sm:gap-4 sm:px-6 lg:px-8'
  >
    <a href={isLanding ? '/#' : '/'} class='relative z-1 shrink-0' data-astro-prefetch>
      <span class='sr-only'>Bioeasy Galenos</span>
      <picture>
        <source srcset='/brand/logo-teal.avif' type='image/avif' />
        <source srcset='/brand/logo-teal.webp' type='image/webp' />
        <img
          class:list={[brandImg, 'h-8 w-auto sm:h-9']}
          src='/brand/logo-teal.webp'
          width='476'
          height='96'
          alt='Bioeasy Galenos'
          loading='eager'
          fetchpriority='high'
        />
      </picture>
    </a>

    <div id='navbar-sticky' class='hidden w-full lg:flex lg:justify-center lg:justify-self-center'>
      <ul class='flex flex-row items-center gap-0.5'>
        {navItems.map((item) => (
          <li>
            <a href={item.href} class={navLink} data-nav-section={item.sectionId}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class='relative z-1 flex shrink-0 items-center justify-end gap-2'>
      <a href='/campusvirtual' target='_blank' rel='noreferrer noopener' class={headerCta}> Campus Virtual </a>
      <button
        data-menu-toggle
        type='button'
        class={menuToggle}
        aria-controls='mobile-nav-panel'
        aria-expanded='false'
        aria-label='Abrir menú'
      >
        <div class='relative size-6'>
          <X
            data-menu-close-icon
            class='absolute inset-0 size-6 scale-75 -rotate-90 opacity-0 transition-all duration-300'
            aria-hidden='true'
          />
          <Menu
            data-menu-open-icon
            class='absolute inset-0 size-6 scale-100 rotate-0 opacity-100 transition-all duration-300'
            aria-hidden='true'
          />
        </div>
      </button>
    </div>
  </nav>
</header>

<div
  data-menu-backdrop
  class='pointer-events-none fixed inset-0 z-40 bg-teal-950/50 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden'
  aria-hidden='true'
/>
<div
  id='mobile-nav-panel'
  role='dialog'
  aria-label='Menú principal'
  aria-hidden='true'
  class='pointer-events-none fixed inset-x-0 top-16 bottom-0 z-40 flex translate-y-full flex-col bg-white transition-transform duration-300 ease-out lg:hidden'
>
  <nav class='min-h-0 flex-1 overflow-y-auto'>
    <ul class='flex flex-col gap-1 px-5 pt-4 pb-6'>
      {navItems.map((item) => (
        <li>
          <a href={item.href} class={mobileNavLink} data-nav-section={item.sectionId} data-mobile-nav-link>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class='shrink-0 border-t border-gray-100 p-5 pb-[max(1.25rem,env(safe-area-inset-bottom))]'>
    <a
      href='/campusvirtual'
      target='_blank'
      rel='noreferrer noopener'
      data-mobile-nav-link
      class='inline-flex w-full items-center justify-center gap-2 rounded-xl bg-teal-700 px-4 py-4 text-base font-semibold text-white shadow-sm shadow-teal-900/15 transition-colors hover:bg-teal-800 focus:ring-4 focus:ring-teal-300/50 focus:outline-hidden'
    >
      Campus Virtual
    </a>
  </div>
</div>

<script>import '@/lib/header-nav'</script>
{isLanding && <script>import '@/lib/landing-header-scroll'</script>}
