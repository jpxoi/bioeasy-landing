---
import { getCdnImageUrl } from '../lib/cdn-image'
import { WHATSAPP_URL } from '@/lib/whatsapp'
import { ArrowRight } from '@lucide/astro'

interface Props {
  id: string
  title: string
  description: string
  imageKey: string
  tag: string
  category: string
}

const { id, title, description, imageKey, tag, category } = Astro.props

const cdnURL = import.meta.env.PUBLIC_CDN_URL
const avifSrc = getCdnImageUrl(cdnURL, imageKey, 'avif')
const webpSrc = getCdnImageUrl(cdnURL, imageKey, 'webp')
const fallbackSrc = webpSrc

const className = `course-card mix group ${category} max-w-sm flex flex-col rounded-lg border border-gray-200 bg-white shadow-sm`

const whatsappMessage = `Hola, estoy interesado en obtener más información sobre el curso "${title}" que aparece en su página web. ¿Podrían brindarme detalles sobre inscripción, duración y requisitos? Gracias.`
const whatsappLink = `${WHATSAPP_URL}?text=${encodeURIComponent(whatsappMessage)}`
---

<div class={className} id={id}>
  <div class='aspect-square overflow-hidden rounded-t-lg sm:aspect-8/10'>
    <picture class='block size-full'>
      <source srcset={avifSrc} type='image/avif' />
      <source srcset={webpSrc} type='image/webp' />
      <img
        class='size-full object-cover transition-transform duration-500 ease-out group-hover:scale-105'
        loading='lazy'
        src={fallbackSrc}
        alt={`Imagen del curso ${title} de Bioeasy Galenos`}
        width='800'
        height='1000'
      />
    </picture>
  </div>
  <div class='flex flex-1 flex-col gap-4 p-5'>
    <div class='flex flex-1 flex-col gap-2'>
      <div class='flex items-center justify-start gap-2'>
        <span
          class='items-center rounded-md bg-[#005FAE] px-2 py-1 text-xs font-medium text-white ring-1 ring-[#005FAE]/20 ring-inset'
        >
          UPAO
        </span>
        {
          /*
      <span class="items-center rounded-md bg-[#E30512] px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-[#E30512]/20">
        UCV
      </span>
      <span class="items-center rounded-md bg-[#fdba30] px-2 py-1 text-xs font-medium text-black ring-1 ring-inset ring-[#fdba30]/20">
        UPN
      </span> */
        }
        <span
          class='items-center rounded-md bg-teal-50 px-2 py-1 text-xs font-medium text-teal-800 ring-1 ring-teal-600/20 ring-inset'
        >
          {tag}
        </span>
      </div>
      <h3 class='text-lg font-semibold tracking-tight text-gray-900'>
        {title}
      </h3>
      <p class='line-clamp-5 text-left text-sm font-normal text-gray-700'>
        {description}
      </p>
    </div>
    <a
      href={whatsappLink}
      target='_blank'
      rel='noreferrer noopener'
      class='inline-flex items-center gap-1 text-sm font-medium text-teal-700 hover:text-teal-800 hover:underline'
    >
      Inscríbete
      <ArrowRight class='size-3.5' aria-hidden='true' />
    </a>
  </div>
</div>
