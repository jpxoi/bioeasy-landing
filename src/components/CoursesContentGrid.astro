---
import { Plus } from '@lucide/astro'
import CourseCard from './CourseCard.astro'

import { db, Courses } from 'astro:db'
const courses = await db.select().from(Courses)
---

<div class='courses__content mx-auto flex w-full max-w-7xl flex-col items-center gap-6'>
  <div class='courses__content__grid grid w-full grid-cols-2 justify-items-center gap-4 md:grid-cols-3 xl:grid-cols-4'>
    {courses.map((course) => <CourseCard {...course} />)}
  </div>
  <button
    type='button'
    class='load_more_button inline-flex h-10 w-full items-center justify-center gap-1 rounded-lg bg-transparent px-6 text-sm font-medium text-teal-700 transition-colors hover:bg-teal-700/10 disabled:hidden sm:w-fit sm:text-base'
  >
    <Plus class='size-4' />
    <span>Cargar más</span>
  </button>
</div>

<script>
  const containerEl = document.querySelector<HTMLElement>('.courses__content__grid')
  const loadMoreButtonEl = document.querySelector('.load_more_button') as HTMLButtonElement
  const coursesSectionEl = document.getElementById('cursos')

  let initialized = false

  async function initCoursesMixer() {
    if (initialized || !containerEl || !loadMoreButtonEl) return
    initialized = true
    const gridEl = containerEl

    const [{ default: mixitup }, { default: mixitupPagination }, { getGridColumnsFromViewport, getPageSize }] =
      await Promise.all([import('mixitup'), import('mixitup-pagination'), import('../lib/courses-grid')])

    mixitup.use(mixitupPagination)

    let currentLimit = getPageSize(getGridColumnsFromViewport())

    const mixer = mixitup(gridEl, {
      selectors: {
        target: '.course__card',
      },
      pagination: {
        limit: currentLimit,
      },
      animation: {
        duration: 300,
      },
      callbacks: {
        onMixEnd: handleMixEnd,
      },
    })

    function handleMixEnd(state: any) {
      const reachedEnd = state.activePagination.limit >= state.totalMatching
      loadMoreButtonEl.disabled = reachedEnd
    }

    function handleLoadMoreClick() {
      const { totalMatching } = mixer.getState()
      currentLimit = Math.min(currentLimit + getPageSize(getGridColumnsFromViewport()), totalMatching)
      mixer.paginate({ limit: currentLimit })
    }

    loadMoreButtonEl.addEventListener('click', handleLoadMoreClick, { once: false })
  }

  if (coursesSectionEl && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return

        observer.disconnect()
        void initCoursesMixer()
      },
      { rootMargin: '900px 0px' },
    )

    observer.observe(coursesSectionEl)
  } else {
    void initCoursesMixer()
  }
</script>
