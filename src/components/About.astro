---
import { getCdnImageUrl } from '@/lib/cdn-image'
import SectionHeading from './SectionHeading.astro'
import WhyCard from './WhyCard.astro'

const cdnURL = import.meta.env.PUBLIC_CDN_URL
const avifSrc = getCdnImageUrl(cdnURL, 'site/web_bg_alt', 'avif')
const webpSrc = getCdnImageUrl(cdnURL, 'site/web_bg_alt', 'webp')
const fallbackSrc = webpSrc

const why_items = [
  {
    icon: 'award' as const,
    description: 'Garantizamos el éxito de los estudiantes en sus desafíos académicos durante la universidad.',
  },
  {
    icon: 'heart' as const,
    description: 'Elevamos la satisfacción de nuestros estudiantes al máximo en todos nuestros cursos.',
  },
  {
    icon: 'lightbulb' as const,
    description: 'Perseguimos la innovación constante en nuestro enfoque académico para destacar en todos los cursos.',
  },
  {
    icon: 'book-open' as const,
    description: 'Revolucionamos la enseñanza de la Medicina mediante métodos didácticos e innovadores.',
  },
]
---

<section id='nosotros' class='mx-auto flex w-full max-w-6xl flex-col gap-6 pt-24 max-xl:px-8 md:gap-10 md:pt-28'>
  <SectionHeading title='Nosotros' />
  <div class='grid gap-4 md:gap-8 lg:grid-cols-2 lg:gap-12'>
    <div>
      <p class='mb-1 text-left font-normal text-gray-800 lg:mb-2'>
        Fundada en el 2017 con el objetivo de innovar y ofrecer una preparación académica de calidad a estudiantes de
        medicina a nivel local.
      </p>
      <p class='mb-3 text-left font-normal text-gray-800 lg:mb-4'>
        Creemos en el potencial de nuestros estudiantes y hemos diseñado un método de estudio efectivo para que los
        estudiantes puedan rendir con éxito los diferentes exámenes de la carrera de Medicina.
      </p>
      <h3 class='mb-1 text-left text-lg font-bold text-gray-900 lg:mb-2'>Nuestra experiencia nos respalda</h3>
      <p class='mb-1 text-left font-normal text-gray-800 lg:mb-2'>
        Más de 1000 estudiantes de 1º a 12º ciclo de UPAO forman parte de la comunidad BG.
      </p>
    </div>
    <div>
      <picture>
        <source srcset={avifSrc} type='image/avif' />
        <source srcset={webpSrc} type='image/webp' />
        <img
          class='w-full rounded-md'
          src={fallbackSrc}
          alt='Estudiantes de medicina en un aula de Bioeasy Galenos durante una clase de preparación académica'
          width='1600'
          height='900'
          loading='lazy'
          decoding='async'
        />
      </picture>
    </div>
  </div>
  <div class='flex flex-col gap-6 pt-12 md:gap-8 md:pt-16'>
    <SectionHeading level='h3' title='¿Por qué elegirnos?' />
    <div class='grid grid-cols-1 justify-items-center gap-4 sm:grid-cols-2 lg:grid-cols-4'>
      {why_items.map((item) => <WhyCard why_description={item.description} icon={item.icon} />)}
    </div>
  </div>
</section>
