---
import Layout from '@/layouts/Layout.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import Prose from '@/components/Prose.astro'

interface Props {
  title: string
  description: string
  canonicalPath: string
  updated: string
}

const { title, description, canonicalPath, updated } = Astro.props
---

<Layout title={`${title} — Bioeasy Galenos`} description={description} canonicalPath={canonicalPath}>
  <Header />
  <main class='bg-white'>
    <article class='mx-auto max-w-3xl px-4 pt-28 pb-20 sm:px-6 lg:pb-28'>
      <header class='mb-8 border-b border-gray-200 pb-5'>
        <h1 class='text-3xl font-bold tracking-tight text-balance text-gray-900 sm:text-4xl'>{title}</h1>
        <p class='mt-2 text-sm text-gray-500'>Última actualización: {updated}</p>
      </header>

      <Prose>
        <slot />
      </Prose>
    </article>
  </main>
  <Footer />
</Layout>
