---
import { Font } from 'astro:assets'
import '../styles/global.css'
import { getCdnImageUrl } from '@/lib/cdn-image'

const cdnURL = import.meta.env.PUBLIC_CDN_URL
---

<html lang='es'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />

    <!--=============== FAVICON ===============-->
    <link rel='icon' type='image/png' href='/favicon/favicon-96x96.png?v=20260528' sizes='96x96' />
    <link rel='icon' type='image/svg+xml' href='/favicon/favicon.svg?v=20260528' />
    <link rel='shortcut icon' href='/favicon/favicon.ico?v=20260528' />
    <link rel='apple-touch-icon' sizes='180x180' href='/favicon/apple-touch-icon.png?v=20260528' />
    <meta name='apple-mobile-web-app-title' content='Bioeasy Galenos' />
    <link rel='manifest' href='/site.webmanifest?v=20260528' />

    <link rel='canonical' href='https://bgmedicina.com' />
    <Font cssVariable='--font-nunito' preload />

    <link rel='preconnect' href='https://cdn.bgmedicina.com' crossorigin />

    <!--=============== SAFARI BAR COLOR ===============-->
    <meta name='theme-color' content='#ffffff' media='(prefers-color-scheme: light)' />
    <meta name='theme-color' content='#0a5457' media='(prefers-color-scheme: dark)' />

    <!--=============== SEO ===============-->
    <!-- Primary Meta Tags -->
    <title>Bioeasy Galenos — Academia de Medicina</title>
    <meta name='title' content='Bioeasy Galenos — Academia de Medicina' />
    <meta
      name='description'
      content='En Bioeasy Galenos creemos en el potencial de nuestros estudiantes y ofrecemos un método de estudio eficaz para que puedan rendir con éxito los exámenes de Medicina.'
    />

    <!-- Open Graph / Facebook -->
    <meta property='og:type' content='website' />
    <meta property='og:url' content='https://bgmedicina.com/' />
    <meta property='og:title' content='Bioeasy Galenos — Academia de Medicina' />
    <meta
      property='og:description'
      content='En Bioeasy Galenos creemos en el potencial de nuestros estudiantes y ofrecemos un método de estudio eficaz para que puedan rendir con éxito los exámenes de Medicina.'
    />
    <meta property='og:image' content={getCdnImageUrl(cdnURL, 'site/web_bg.webp', 'webp')} />
    <meta property='og:image:alt' content='Doctor vestido de superhéroe, con un antifaz rojo y una capa.' />

    <!-- Twitter -->
    <meta property='twitter:card' content='summary_large_image' />
    <meta property='twitter:url' content='https://bgmedicina.com/' />
    <meta property='twitter:title' content='Bioeasy Galenos — Academia de Medicina' />
    <meta
      property='twitter:description'
      content='En Bioeasy Galenos creemos en el potencial de nuestros estudiantes y ofrecemos un método de estudio eficaz para que puedan rendir con éxito los exámenes de Medicina.'
    />
    <meta property='twitter:image' content={getCdnImageUrl(cdnURL, 'site/web_bg.webp', 'webp')} />
  </head>
  <body>
    <slot />
  </body>
</html>
