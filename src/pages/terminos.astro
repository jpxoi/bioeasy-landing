---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
---

<Layout
  title='Términos y Condiciones — Bioeasy Galenos'
  description='Términos y condiciones de uso del sitio web de Bioeasy Galenos.'
  canonicalPath='/terminos'
>
  <Header />
  <main class='bg-white'>
    <article class='mx-auto max-w-3xl px-4 pt-28 pb-16 sm:px-6 lg:px-8 lg:pb-24'>
      <header class='mb-12 border-b border-gray-200 pb-8'>
        <h1 class='text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl'>Términos y condiciones</h1>
        <p class='mt-3 text-sm text-gray-500'>Próximamente</p>
      </header>
    </article>
  </main>
  <Footer />
</Layout>
